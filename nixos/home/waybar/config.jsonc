// -*- mode: jsonc -*-
{
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "left",
  "fixed-center": true,
  "ipc": true,
  // Choose the order of the modules
  "modules-left": [
    "hyprland/workspaces"
  ],
  // Resting view (super+i OFF): volume, battery, clock only. super+i swaps to
  // config-full.jsonc which adds cpu/memory/temperature and a value under each icon.
  "modules-right": [
    // "power-profiles-daemon",
    "pulseaudio",
    "battery",
    "battery#bat2",
    // "idle_inhibitor",
    "clock"
  ],
  // Modules configuration
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "",
      "urgent": "",
    },
    "show-special": false,
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true,
    // "on-scroll-up": "hyprctl dispatch workspace e+1",
    // "on-scroll-down": "hyprctl dispatch workspace e-1",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "clock": {
    "align": 0.5,
    "justify": "center",
    // "timezone": "America/New_York",
    "format": "{:%H\n%M}",
    "format-alt": "{:%d\n%m}",
    "tooltip": true,
    "tooltip-format": "{:%A %d %B %Y  %H:%M}",
  },
  "cpu": {
    "align": 0.5,
    "justify": "center",
    "format": "",
    "tooltip": true,
  },
  "memory": {
    "align": 0.5,
    "justify": "center",
    "format": "",
    "tooltip-format": "Memory  {percentage}% ({used:.1f}/{total:.1f} GiB)",
  },
  "temperature": {
    "align": 0.5,
    "justify": "center",
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "",
    "tooltip-format": "{temperatureC}°C",
  },
  "battery": {
    "align": 0.5,
    "justify": "center",
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}\n<span size='8192'>{capacity}%</span>",
    "tooltip-format": "Battery  {capacity}% · {time}",
    "format-full": "{icon}\n<span size='8192'>{capacity}%</span>",
    "format-charging": "\n<span size='8192'>{capacity}%</span>",
    "format-plugged": "\n<span size='8192'>{capacity}%</span>",
    "format-alt": "{icon}\n<span size='8192'>{capacity}%</span>",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
  },
  "battery#bat2": {
    "bat": "BAT2",
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
  },
  "pulseaudio": {
    "align": 0.5,
    "justify": "center",
    // "scroll-step": 1, // %, can be a float
    "format": "{icon}\n<span size='8192'>{volume}%</span>",
    "tooltip-format": "Volume  {volume}% · {desc}",
    "format-bluetooth": "{icon}\n<span size='8192'>{volume}%</span>",
    "format-bluetooth-muted": "",
    "format-muted": "",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ],
    },
    "on-click": "pavucontrol",
  },
}